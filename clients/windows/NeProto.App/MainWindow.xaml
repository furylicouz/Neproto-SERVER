<Window x:Class="NeProto.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NeProto" Width="860" Height="700" MinWidth="760" MinHeight="620"
        WindowStartupLocation="CenterScreen" Style="{StaticResource NeProtoWindowStyle}">
  <Grid Background="{StaticResource WindowBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="62" />
      <RowDefinition Height="48" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" Margin="24,0">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Border Width="34" Height="34" CornerRadius="11" Background="{StaticResource AccentBrush}">
          <TextBlock Text="N" Foreground="White" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
          <TextBlock Text="NeProto" FontSize="17" FontWeight="SemiBold" />
          <TextBlock Text="NP/2 Constellation" Foreground="{StaticResource SubtleTextBrush}" FontSize="10" Margin="0,2,0,0" />
        </StackPanel>
      </StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
          <Ellipse Width="7" Height="7" Fill="{Binding ConnectionBrush}" Margin="0,0,7,0" />
          <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" />
        </StackPanel>
        <Button Width="38" Height="38" Padding="0" Style="{StaticResource QuietButtonStyle}" Click="Add_Click" AutomationProperties.Name="Добавить сервер">
          <TextBlock Text="＋" FontSize="19" HorizontalAlignment="Center" />
        </Button>
      </StackPanel>
    </Grid>

    <Border Grid.Row="1" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,1">
      <StackPanel Orientation="Horizontal" Margin="24,0">
        <Button Style="{StaticResource TopNavButtonStyle}" Tag="{Binding IsHome}" Click="Home_Click" AutomationProperties.Name="Главная"><TextBlock Text="Главная"/></Button>
        <Button Style="{StaticResource TopNavButtonStyle}" Tag="{Binding IsRoutes}" Click="Routes_Click" AutomationProperties.Name="Маршруты"><TextBlock Text="Маршруты"/></Button>
        <Button Style="{StaticResource TopNavButtonStyle}" Tag="{Binding IsLogs}" Click="Logs_Click" AutomationProperties.Name="Журнал"><TextBlock Text="Журнал"/></Button>
      </StackPanel>
    </Border>

    <Grid Grid.Row="2" Margin="24,18,24,22">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

      <Border Grid.Row="0" Background="#2B1518" BorderBrush="#6B2A31" BorderThickness="1" CornerRadius="12" Padding="13" Margin="0,0,0,14" MaxWidth="720"
              HorizontalAlignment="Center" Visibility="{Binding HasServiceError, Converter={StaticResource BoolToVisibility}}">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="!" Foreground="#FDA4AF" FontWeight="Bold" HorizontalAlignment="Center"/><TextBlock Grid.Column="1" Text="{Binding ServiceError}" TextWrapping="Wrap" Foreground="#FECDD3" FontSize="12"/></Grid>
      </Border>

      <Grid Grid.Row="1" Width="680" HorizontalAlignment="Center" Visibility="{Binding IsHome, Converter={StaticResource BoolToVisibility}}">
        <Border CornerRadius="26" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
          <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#192231" Offset="0"/><GradientStop Color="#11161F" Offset="0.52"/><GradientStop Color="#0E1219" Offset="1"/></LinearGradientBrush>
          </Border.Background>
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="88"/><RowDefinition Height="*"/><RowDefinition Height="112"/></Grid.RowDefinitions>

            <Button Grid.Row="0" Background="Transparent" BorderThickness="0" Padding="22,15" HorizontalContentAlignment="Stretch" Click="Servers_Click" AutomationProperties.Name="Выбрать сервер">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Border Width="44" Height="44" Background="#253044" CornerRadius="14"><TextBlock Text="{Binding LocationGlyph}" FontFamily="Segoe UI Emoji" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center"><TextBlock Text="{Binding ProfileName}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding ServerIdentity}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/></StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="{Binding SignalText}" Foreground="{Binding ConnectionBrush}" FontSize="13" Margin="0,0,15,0"/><TextBlock Text="›" Foreground="{StaticResource SecondaryTextBrush}" FontSize="26"/></StackPanel>
              </Grid>
            </Button>
            <Border Grid.Row="0" BorderBrush="#283447" BorderThickness="0,0,0,1" IsHitTestVisible="False"/>

            <Grid Grid.Row="1">
              <Ellipse Width="242" Height="242" Fill="{Binding ActionBrush}" Opacity="0.055"/>
              <Ellipse Width="202" Height="202" Fill="{Binding ActionBrush}" Opacity="0.10"/>
              <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="{Binding StatusText}" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding DurationText}" Foreground="{StaticResource SecondaryTextBrush}" FontFamily="Cascadia Mono, Consolas" FontSize="13" HorizontalAlignment="Center" Margin="0,6,0,15"/>
                <Button Width="142" Height="142" Padding="0" Style="{StaticResource PowerButtonStyle}" Background="{Binding ActionBrush}" Foreground="{Binding ActionForegroundBrush}"
                        Click="Toggle_Click" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}" AutomationProperties.Name="{Binding ToggleActionText}">
                  <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="&#xE7E8;" FontFamily="Segoe MDL2 Assets" FontSize="44" HorizontalAlignment="Center"/><TextBlock Text="{Binding ToggleActionText}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,8,0,0"/></StackPanel>
                </Button>
                <TextBlock Text="{Binding ConnectionDescription}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" TextWrapping="Wrap" TextAlignment="Center" Width="390" Margin="0,14,0,0"/>
              </StackPanel>
            </Grid>

            <Border Grid.Row="2" Background="#B20B0F16" CornerRadius="0,0,26,26" BorderBrush="#283447" BorderThickness="0,1,0,0">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="1"/><ColumnDefinition/><ColumnDefinition Width="1"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center"><TextBlock Text="СКАЧИВАНИЕ" Foreground="{StaticResource SubtleTextBrush}" FontSize="9" FontWeight="SemiBold"/><TextBlock Text="{Binding DownloadText}" FontSize="19" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,8,0,0"/><TextBlock Text="{Binding DownloadTotalText}" Foreground="{StaticResource SubtleTextBrush}" FontSize="10" HorizontalAlignment="Center" Margin="0,3,0,0"/></StackPanel>
                <Border Grid.Column="1" Background="{StaticResource BorderBrush}" Margin="0,20"/>
                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Center"><TextBlock Text="ОТПРАВКА" Foreground="{StaticResource SubtleTextBrush}" FontSize="9" FontWeight="SemiBold"/><TextBlock Text="{Binding UploadText}" FontSize="19" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,8,0,0"/><TextBlock Text="{Binding UploadTotalText}" Foreground="{StaticResource SubtleTextBrush}" FontSize="10" HorizontalAlignment="Center" Margin="0,3,0,0"/></StackPanel>
                <Border Grid.Column="3" Background="{StaticResource BorderBrush}" Margin="0,20"/>
                <StackPanel Grid.Column="4" VerticalAlignment="Center" HorizontalAlignment="Center"><TextBlock Text="КАНАЛ" Foreground="{StaticResource SubtleTextBrush}" FontSize="9" FontWeight="SemiBold"/><TextBlock Text="{Binding CarrierText}" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,10,0,0"/><TextBlock Text="{Binding RegionText}" Foreground="{StaticResource SubtleTextBrush}" FontSize="10" HorizontalAlignment="Center" Margin="0,5,0,0"/></StackPanel>
              </Grid>
            </Border>
          </Grid>
        </Border>
      </Grid>

      <Grid Grid.Row="1" Width="680" HorizontalAlignment="Center" Visibility="{Binding IsRoutes, Converter={StaticResource BoolToVisibility}}">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="2,0,0,16"><TextBlock Text="Маршруты" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="Правила направления трафика через узлы кластера" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" Margin="0,5,0,0"/></StackPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,12"><Button Style="{StaticResource QuietButtonStyle}" Click="SyncRoutes_Click" Margin="0,0,8,0" Content="Синхронизировать"/><Button Style="{StaticResource AccentButtonStyle}" Click="AddRoute_Click" Content="＋ Добавить маршрут"/></StackPanel>
        <Border Grid.Row="2" Style="{StaticResource SoftCardStyle}" Padding="5"><Grid><ListView ItemsSource="{Binding Routes}" Background="Transparent" BorderThickness="0"><ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/><Setter Property="BorderThickness" Value="0,0,0,1"/><Setter Property="Foreground" Value="{StaticResource ForegroundBrush}"/></Style></ListView.ItemContainerStyle><ListView.ItemTemplate><DataTemplate><Grid Margin="14,12"><Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Width="30" Height="30" Background="{StaticResource SurfaceRaisedBrush}" CornerRadius="9"><TextBlock Text="↗" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" Margin="10,0"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"/><TextBlock Text="{Binding Description}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/></StackPanel><Button Grid.Column="2" Content="Удалить" Tag="{Binding Id}" Style="{StaticResource QuietButtonStyle}" Margin="8,0,0,0" Padding="10,6" Visibility="{Binding CanDelete, Converter={StaticResource BoolToVisibility}}" Click="RemoveRoute_Click"/></Grid></DataTemplate></ListView.ItemTemplate></ListView><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" Visibility="{Binding HasNoRoutes, Converter={StaticResource BoolToVisibility}}"><TextBlock Text="Маршрутов пока нет" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock Text="Синхронизируйте каталог или добавьте локальное правило." Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" Margin="0,6,0,0"/></StackPanel></Grid></Border>
      </Grid>

      <Grid Grid.Row="1" Width="680" HorizontalAlignment="Center" Visibility="{Binding IsLogs, Converter={StaticResource BoolToVisibility}}">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="2,0,0,16"><TextBlock Text="Журнал" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="События приложения и туннельной службы" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" Margin="0,5,0,0"/></StackPanel>
        <Border Grid.Row="1" Style="{StaticResource SoftCardStyle}" Padding="5"><ListView ItemsSource="{Binding Logs}" Background="Transparent" BorderThickness="0"><ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/><Setter Property="BorderThickness" Value="0,0,0,1"/><Setter Property="Foreground" Value="{StaticResource ForegroundBrush}"/></Style></ListView.ItemContainerStyle><ListView.ItemTemplate><DataTemplate><Grid Margin="12,9"><Grid.ColumnDefinitions><ColumnDefinition Width="82"/><ColumnDefinition Width="66"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Time, StringFormat={}{0:HH:mm:ss}}" Foreground="{StaticResource SubtleTextBrush}" FontFamily="Cascadia Mono, Consolas" FontSize="11"/><TextBlock Grid.Column="1" Text="{Binding Level}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11"/><TextBlock Grid.Column="2" Text="{Binding Message}" TextWrapping="Wrap" FontFamily="Cascadia Mono, Consolas" FontSize="11"/></Grid></DataTemplate></ListView.ItemTemplate></ListView></Border>
      </Grid>
    </Grid>
  </Grid>
</Window>
