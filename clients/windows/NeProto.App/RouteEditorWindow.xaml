<Window x:Class="NeProto.App.RouteEditorWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Новый маршрут" Width="610" Height="570" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Style="{StaticResource NeProtoWindowStyle}">
  <Grid Margin="28">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock Text="Новый маршрут" FontSize="26" FontWeight="SemiBold"/>
    <StackPanel Grid.Row="1" Margin="0,22,0,0">
      <TextBlock Text="Название" Foreground="{StaticResource SecondaryTextBrush}"/><TextBox x:Name="NameBox" Margin="0,6,0,14"/>
      <TextBlock Text="Домены" Foreground="{StaticResource SecondaryTextBrush}"/><TextBox x:Name="DomainsBox" Margin="0,6,0,4"/><TextBlock Text="Через запятую: openai.com, chatgpt.com" Foreground="#71717A" FontSize="12" Margin="2,0,0,14"/>
      <TextBlock Text="IP/CIDR" Foreground="{StaticResource SecondaryTextBrush}"/><TextBox x:Name="CidrsBox" Margin="0,6,0,4"/><TextBlock Text="Например: 8.8.8.0/24" Foreground="#71717A" FontSize="12" Margin="2,0,0,14"/>
      <TextBlock Text="Действие" Foreground="{StaticResource SecondaryTextBrush}"/>
      <ComboBox x:Name="ActionBox" Margin="0,6,0,14" SelectionChanged="Action_Changed"><ComboBoxItem Content="Автовыбор" Tag="auto" IsSelected="True"/><ComboBoxItem Content="Текущий сервер" Tag="current"/><ComboBoxItem Content="Другой сервер" Tag="node"/><ComboBoxItem Content="Напрямую" Tag="direct"/><ComboBoxItem Content="Блокировать" Tag="block"/></ComboBox>
      <ComboBox x:Name="NodeBox" DisplayMemberPath="Name" SelectedValuePath="ClusterNodeId" Visibility="Collapsed"/>
    </StackPanel>
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Отмена" Width="110" Margin="0,0,10,0" Click="Cancel_Click"/><Button Content="Добавить" Width="120" Style="{StaticResource PrimaryButtonStyle}" Click="Save_Click"/></StackPanel>
  </Grid>
</Window>
