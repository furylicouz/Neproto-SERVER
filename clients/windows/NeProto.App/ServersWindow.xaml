<Window x:Class="NeProto.App.ServersWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Серверы NP/2" Width="700" Height="560" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Style="{StaticResource NeProtoWindowStyle}">
  <Grid Margin="28">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,18"><TextBlock Text="Серверы" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="Доступные узлы и импортированные профили NP/2" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,5,0,0"/></StackPanel>
    <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="8">
      <ListBox x:Name="ProfilesList" ItemsSource="{Binding Profiles}" Background="Transparent" BorderThickness="0">
        <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Foreground" Value="{StaticResource ForegroundBrush}"/><Setter Property="Background" Value="Transparent"/><Setter Property="Padding" Value="6"/><Setter Property="Margin" Value="0,2"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}"/></Trigger></Style.Triggers></Style></ListBox.ItemContainerStyle>
        <ListBox.ItemTemplate><DataTemplate><Grid Margin="8"><Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Width="38" Height="38" Background="{StaticResource SurfaceRaisedBrush}" CornerRadius="9"><TextBlock Text="🌐" FontFamily="Segoe UI Emoji" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" Margin="12,0"><TextBlock Text="{Binding Name}" FontWeight="Medium" FontSize="14"/><TextBlock Text="{Binding ServerIdentity}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" Margin="0,3,0,0"/></StackPanel><TextBlock Grid.Column="2" Text="▂▄▆█" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center"/></Grid></DataTemplate></ListBox.ItemTemplate>
      </ListBox>
    </Border>
    <Grid Grid.Row="2" Margin="0,18,0,0"><Button Content="Удалить" Width="110" HorizontalAlignment="Left" Click="Remove_Click"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Выбрать" Width="120" Style="{StaticResource PrimaryButtonStyle}" Click="Select_Click"/><Button Content="Закрыть" Width="110" Margin="10,0,0,0" Click="Close_Click"/></StackPanel></Grid>
  </Grid>
</Window>
