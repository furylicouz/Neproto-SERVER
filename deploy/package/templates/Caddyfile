{
	servers {
		protocols h1 h2
	}
}

__DOMAIN__ {
	tls /etc/neproto/tls/fullchain.pem /etc/neproto/tls/privkey.pem
	handle /.well-known/acme-challenge/* {
		root * /var/www/certbot
		file_server
	}
	handle __HTTPS_PATH__ {
		reverse_proxy 127.0.0.1:9080
	}
	handle __WEBRTC_PATH__ {
		reverse_proxy 127.0.0.1:9080
	}
	handle {
		root * /var/www/neproto
		encode zstd gzip
		header {
			Content-Security-Policy "default-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
			Permissions-Policy "camera=(), microphone=(), geolocation=()"
			Referrer-Policy no-referrer
			X-Content-Type-Options nosniff
			X-Frame-Options DENY
		}
		try_files {path} /index.html
		file_server
	}
}
